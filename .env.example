# Server-only credentials. Never commit real values.
NAVER_MAP_CLIENT_ID=
NAVER_MAP_CLIENT_SECRET=
KAKAO_REST_API_KEY=

# Browser-safe Supabase connection. Publishable key is intentionally client-safe.
VITE_SUPABASE_URL=https://neeqcfxjwotyiodrlzvq.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# Browser SDK public key. Restrict allowed domains in Kakao Developers.
VITE_KAKAO_JAVASCRIPT_KEY=

# Browser-safe protected proxy origin. Leave blank for same-origin /api.
# Production cross-origin example: https://api.example.com
VITE_API_BASE_URL=

# Protected map/POI proxy runtime. Use exact production origins; never use *.
MAP_PROXY_HOST=127.0.0.1
MAP_PROXY_PORT=5175
MAP_PROXY_ALLOWED_ORIGINS=http://localhost:5174

# Self-hosted production frontend runtime. External TLS/reverse proxy terminates HTTPS.
FRONTEND_HOST=0.0.0.0
FRONTEND_PORT=4174
MAP_PROXY_INTERNAL_URL=http://127.0.0.1:5175
